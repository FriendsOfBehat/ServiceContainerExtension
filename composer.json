{
    "name": "friends-of-behat/service-container-extension",
    "description": "Allows to declare own services inside Behat container without writing an extension.",
    "license": "MIT",
    "authors": [
        {
            "name": "Kamil Kokot",
            "email": "kamil@kokot.me",
            "homepage": "https://kamilkokot.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "behat/behat": "^3.31",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4"
    },
    "require-dev": {
        "symfony/filesystem": "^7.4",
        "symfony/process": "^7.4",
        "symfony/yaml": "^7.4",
        "vimeo/psalm": "^6.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.3-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "FriendsOfBehat\\ServiceContainerExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/behat -f progress --strict -vvv --no-interaction --colors"
        ]
    }
}
