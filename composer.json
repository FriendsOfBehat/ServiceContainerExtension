{
    "name": "friends-of-behat/service-container-extension",
    "description": "Allows to declare own services inside Behat container without writing an extension.",
    "license": "MIT",
    "authors": [
        {
            "name": "Kamil Kokot",
            "email": "kamil@kokot.me",
            "homepage": "https://kamilkokot.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "behat/behat": "^3.31 || ^4.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friends-of-behat/test-context": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.0",
        "vimeo/psalm": "^6.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.1-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "FriendsOfBehat\\ServiceContainerExtension\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/behat -f progress --strict -vvv --no-interaction --colors"
        ],
        "phpstan": [
            "vendor/bin/phpstan analyse --no-progress"
        ],
        "cs": [
            "vendor/bin/php-cs-fixer fix --dry-run --diff"
        ],
        "cs-fix": [
            "vendor/bin/php-cs-fixer fix"
        ]
    }
}
